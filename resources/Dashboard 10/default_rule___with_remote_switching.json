        "singletonMode": false,
        "queueName": null,
        "configurationVersion": 0,
        "configuration": {
          "scriptLang": "JS",
          "jsScript": "// Access telemetry values\nvar remoteSwitching = msg.remoteSwitching ? msg.remoteSwitching : null;\nvar buttonNo = msg.buttonNo ? msg.buttonNo : null;\n//var targetDeviceId = metadata.targetDeviceId;\n var rpcPayload;\n\nif (remoteSwitching) {\n    // Build exact RPC payload\n    rpcPayload = {\n        method: 'remoteSwitch',\n        params: {\n            remoteSwitching: remoteSwitching,\n            buttonNo: buttonNo\n        }\n    };\n\n    // Update message\n    //msg2 = rpcPayload;\n    //msgType2 = 'RPC_REQUEST';\n} else {\n    // No target/fields - log and skip RPC (continue as original)\n    // if (!targetDeviceId) {\n    //     log('No target device via Controls relation');\n    // }\n    // if (!remoteSwitching || !buttonNo) {\n    //     log('Missing remoteSwitching or buttonNo');\n    // }\n}\n\nreturn {msg:rpcPayload , metadata: metadata, msgType:'RPC_REQUEST' };",
          "tbelScript": "// Access telemetry values\nvar remoteSwitching = msg.values ? msg.values.remoteSwitching : null;\nvar buttonNo = msg.values ? msg.values.buttonNo : null;\nvar targetDeviceId = metadata.targetDeviceId;\n\nif (remoteSwitching && buttonNo && targetDeviceId) {\n    // Build exact RPC payload\n    var rpcPayload = {\n        method: 'remoteSwitch',\n        params: {\n            remoteSwitching: remoteSwitching,\n            buttonNo: buttonNo\n        }\n    };\n\n    // Update message\n    msg = rpcPayload;\n    msgType = 'RPC_REQUEST';\n} else {\n    // No target/fields - log and skip RPC (continue as original)\n    if (!targetDeviceId) {\n        log('No target device via Controls relation');\n    }\n    if (!remoteSwitching || !buttonNo) {\n        log('Missing remoteSwitching or buttonNo');\n    }\n}\n\nreturn {msg: msg, metadata: metadata, msgType: msgType};"
        },
