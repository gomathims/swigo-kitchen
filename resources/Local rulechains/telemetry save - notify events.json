        },
        "singletonMode": false,
        "queueName": null,
        "configurationVersion": 0,
        "configuration": {
          "scriptLang": "TBEL",
          "jsScript": "return {msg: msg, metadata: metadata, msgType: msgType};",
          "tbelScript": "var DEDUP_MS = 1000;\nvar newState = msg.relayStatus;\nvar now = new Date().getTime();\nvar onTs  = metadata.ss_lastSwitchingOnNotifyTs  != null ? Long.parseLong(metadata.ss_lastSwitchingOnNotifyTs)  : 0;\nvar offTs = metadata.ss_lastSwitchingOffNotifyTs != null ? Long.parseLong(metadata.ss_lastSwitchingOffNotifyTs) : 0;\n\nmsg.lastSwitchingOnNotifyTs  = onTs;\nmsg.lastSwitchingOffNotifyTs = offTs;\nmsg.shouldNotify = \"false\";\n\nvar lastTs = newState ? onTs : offTs;\nif ((now - lastTs) > DEDUP_MS) {\n    msg.shouldNotify = \"true\";\n    var deviceLabel = (metadata.cs_deviceName != null &&  metadata.cs_deviceName != \"\") ? metadata.cs_deviceName : metadata.deviceType+\" Device\";\n    var suffix = \": \" + msg.eventMessage;\n    if (newState == true) {\n        msg.category = \"switching.on\";\n        msg.title    = \"Device turned ON\";\n        msg.body     = deviceLabel + suffix;\n        msg.lastSwitchingOnNotifyTs = now;\n    } else {\n        msg.category = \"switching.off\";\n        var em = msg.eventMessage != null ? msg.eventMessage.toLowerCase() : \"\";\n        if (em.indexOf(\"stop\") >= 0) \n            msg.title = \"Device turned OFF\";\n        else \n            msg.title    = \"Device remain OFF\";\n        msg.body     = deviceLabel + suffix;\n        msg.lastSwitchingOffNotifyTs = now;\n    }\n}\n\n// return {msg: msg, metadata: metadata, msgType: msg.msgType};\nreturn {msg: msg, metadata: metadata, msgType: \"POST_ATTRIBUTES_REQUEST\"};\n"
        },
