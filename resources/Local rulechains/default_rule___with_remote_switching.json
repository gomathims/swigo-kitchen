        "configuration": {
          "scriptLang": "JS",
          "jsScript": "if (msg.method==\"turnOn\") {\n    var durationHours = metadata.shared_durationHours?metadata.shared_durationHours:0;// Shared attribute from metadata\n    var durationMinutes = metadata.shared_durationMinutes?metadata.shared_durationMinutes:0;\n    if (durationHours==0 && durationMinutes==0)\n        throw \"Invalid duration\";\nvar newMsg = {\n    method: msg.method,\n    params: {\n        durationHours: durationHours, \n        durationMinutes: durationMinutes\n    }\n};\nreturn { msg: newMsg, metadata: metadata, msgType: msgType };\n}\nelse return {msg:msg, metadata: metadata, msgType: msgType };",
