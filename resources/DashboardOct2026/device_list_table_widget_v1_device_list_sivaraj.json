        "headerButton": [
          {
            "name": "Download CSV",
            "buttonType": "icon",
            "icon": "download",
            "buttonColor": "rgba(0,0,0,0.87)",
            "useShowWidgetActionFunction": null,
            "showWidgetActionFunction": "return true;",
            "type": "custom",
            "customFunction": "// Download the current device-list table as CSV (one row per device).\nvar data = widgetContext.data || [];\n\nfunction csvEscape(v) {\n    if (v === null || v === undefined) v = '';\n    v = String(v);\n    if (/[\",\\n]/.test(v)) {\n        v = '\"' + v.replace(/\"/g, '\"\"') + '\"';\n    }\n    return v;\n}\n\nfunction fmt(label, value) {\n    if (value === null || value === undefined || value === '') return '';\n    var l = String(label).toLowerCase();\n    if (l === 'active') {\n        return (String(value) === 'true') ? 'Online' : 'Offline';\n    }\n    if (l === 'on - off') {\n        return (String(value) === 'true') ? 'ON' : 'OFF';\n    }\n    if (l === 'last activity') {\n        var n = Number(value);\n        if (!isNaN(n) && n > 0) {\n            return moment(n).format('DD/MM/YYYY HH:mm:ss');\n        }\n    }\n    return value;\n}\n\nvar headers = [];\nvar seen = {};\nvar entities = {};\nvar order = [];\n\ndata.forEach(function(ds) {\n    var label = ds.dataKey.label;\n    if (!seen[label]) { seen[label] = true; headers.push(label); }\n    var eName = ds.datasource.entityName;\n    if (!entities[eName]) { entities[eName] = {}; order.push(eName); }\n    var v = '';\n    if (ds.data && ds.data.length) { v = ds.data[ds.data.length - 1][1]; }\n    entities[eName][label] = v;\n});\n\nif (!order.length) {\n    return;\n}\n\nvar lines = [];\nlines.push(headers.map(csvEscape).join(','));\n\norder.forEach(function(eName) {\n    var row = entities[eName];\n    var cells = headers.map(function(h) {\n        return csvEscape(fmt(h, row[h]));\n    });\n    lines.push(cells.join(','));\n});\n\nvar csv = lines.join('\\n');\nvar blob = new Blob([\"﻿\" + csv], { type: 'text/csv;charset=utf-8;' });\nvar url = URL.createObjectURL(blob);\nvar link = document.createElement('a');\nlink.setAttribute('href', url);\nvar ts = moment().format('YYYY-MM-DD_HH-mm');\nlink.setAttribute('download', 'device_list_' + ts + '.csv');\ndocument.body.appendChild(link);\nlink.click();\ndocument.body.removeChild(link);\nURL.revokeObjectURL(url);\n",
            "openInSeparateDialog": false,
            "openInPopover": false,
            "id": "5f395c0d-bfaa-6b4e-2a3a-30c188f5448e"
